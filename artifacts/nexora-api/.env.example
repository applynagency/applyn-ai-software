# Copy to .env for local development (never commit .env).

# Core
DATABASE_URL=postgresql+asyncpg://nexora:nexora@localhost:5432/nexora
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# Feature flags (see docker-compose.override.yml)
MONITORING_ENABLED=true
INTEGRATION_GITOPS_SYNC_ENABLED=true
WAR_ROOM_REALTIME_ENABLED=true
UNIVERSAL_DISCOVERY_ENABLED=true

# Production hardening (P3)
# When Redis is HA, set false so rate limits fail closed instead of allowing all traffic.
RATE_LIMIT_FAIL_OPEN=false

# Live connectors — leave empty for simulated/marketplace mode in dev.
# Prometheus (metrics + logs)
PROMETHEUS_URL=
PROMETHEUS_BEARER_TOKEN=

# Argo CD (GitOps sync)
ARGOCD_SERVER_URL=
ARGOCD_AUTH_TOKEN=

# SonarQube (security scans)
SONARQUBE_URL=
SONARQUBE_TOKEN=

# PagerDuty (escalation)
PAGERDUTY_API_TOKEN=
PAGERDUTY_ROUTING_KEY=
