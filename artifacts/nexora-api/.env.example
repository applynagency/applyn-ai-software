APP_NAME=Nexora AI Development Team
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexora

JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3

LOG_LEVEL=INFO
LOG_FORMAT=json

# Sprint 66A/66B — Pilot Center (first customer pilot)
# PILOT_MODE_ENABLED=true
# PILOT_MODE_ALL_ORGS=false
# PILOT_ORGANIZATION_IDS=["<pilot-org-uuid>"]
# PILOT_OPERATION_LIMIT=2
# PILOT_MUTATION_COOLDOWN_MINUTES=15
# PILOT_APPROVAL_EXPIRY_HOURS=24
